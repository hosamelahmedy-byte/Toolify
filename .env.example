# ============================================================
# ToolsHub Pro — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Dashboard Protection ────────────────────────────────────
DASHBOARD_SECRET=your-secret-password-here

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://toolshub.pro
NEXT_PUBLIC_SITE_NAME="ToolsHub Pro"

# ── Google AdSense ───────────────────────────────────────────
# Get from: https://adsense.google.com
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# ── Google Analytics (optional) ─────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Supabase (for future features: favorites, history) ───────
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Upstash Redis (optional — for rate limiting) ─────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ── Analytics (optional — Vercel Analytics is auto-detected) ─
NEXT_PUBLIC_VERCEL_ANALYTICS=true
